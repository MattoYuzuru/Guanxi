{
  "name": "alamo-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @alamo/server",
    "dev:web": "npm run dev --workspace @alamo/web",
    "build": "npm run build --workspace @alamo/web && npm run build --workspace @alamo/server && npm run build --workspace alamo-ui",
    "link:cli": "npm run build && npm link --workspace alamo-ui",
    "test": "npm run test:core && npm run test:web",
    "test:core": "node --test packages/server/test/**/*.test.ts packages/cli/test/**/*.test.ts",
    "test:web": "npm test --workspace @alamo/web",
    "test:web:browser": "npm run test:browser --workspace @alamo/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "alamo-ui": "*",
    "typescript": "^5.7.2"
  }
}
