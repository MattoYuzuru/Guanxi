{
  "name": "guanxi-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @guanxi/server",
    "dev:web": "npm run dev --workspace @guanxi/web",
    "build": "npm run build --workspace @guanxi/web && npm run build --workspace @guanxi/server && npm run build --workspace guanxi",
    "link:cli": "npm run build && npm link --workspace guanxi",
    "test": "npm run ui:check && npm run test:codemods && npm run test:gates --workspace @guanxi/ui && npm run test:core && npm run test:kernel && npm run test:web && npm run test:ui",
    "test:core": "node --test 'packages/server/test/**/*.test.ts' 'packages/cli/test/**/*.test.ts'",
    "test:kernel": "node --test 'packages/kernel/test/**/*.test.ts'",
    "kernel:empty-node": "node packages/kernel/bin/empty-node.ts",
    "test:web": "npm test --workspace @guanxi/web",
    "test:web:browser": "npm run test:browser --workspace @guanxi/web",
    "test:ui": "npm test --workspace @guanxi/ui",
    "ui:check:browser": "npm run ui:check:browser --workspace @guanxi/ui",
    "ui:catalog:selftest": "node packages/ui/gates/catalog/run.ts --mode all --selftest",
    "ui:snapshots": "node packages/ui/gates/catalog/run.ts --mode browser --only G13 --update-snapshots",
    "ui:manifest": "npm run manifest --workspace @guanxi/ui",
    "ui:storybook": "npm run storybook --workspace @guanxi/ui",
    "benchmark:catalog": "node packages/server/scripts/catalog-pagination-benchmark.ts && npm run benchmark:catalog --workspace @guanxi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#.claude/worktrees\" \"#docs/research/2026-10-19-landscape\" \"#docs/research/2026-10-20-design\" \"#docs/research/2026-10-21-fleet\" && node scripts/check-doc-links.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "tokens:build": "npm run tokens:build --workspace @guanxi/ui",
    "ui:check": "npm run ui:check --workspace @guanxi/ui",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:suppressions",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" \"plugins/**/*.css\" --allow-empty-input",
    "lint:suppressions": "node packages/ui/gates/lint/suppressions.mjs",
    "codemod:semantic": "node scripts/codemods/semantic-colours.mjs",
    "test:codemods": "node --test scripts/codemods/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "8.72.0",
    "esbuild": "^0.25.12",
    "eslint": "10.13.0",
    "guanxi": "*",
    "markdownlint-cli2": "0.18.1",
    "stylelint": "17.16.0",
    "typescript": "^5.7.2"
  }
}
