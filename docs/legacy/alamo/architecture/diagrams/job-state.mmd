stateDiagram-v2
    [*] --> queued
    queued --> reserving
    reserving --> loading
    loading --> prefill
    prefill --> thinking
    prefill --> generating
    thinking --> generating
    generating --> waiting_tool
    waiting_tool --> waiting_approval
    waiting_approval --> waiting_tool
    waiting_tool --> prefill
    generating --> finalizing
