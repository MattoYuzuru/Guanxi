    queued --> cancelling
    reserving --> cancelling
    loading --> cancelling
    prefill --> cancelling
    thinking --> cancelling
    generating --> cancelling
    waiting_tool --> cancelling
    waiting_approval --> cancelling
    cancelling --> cancelled

    reserving --> failed
    loading --> failed
    prefill --> failed
    thinking --> failed
    generating --> failed
    waiting_tool --> failed
    finalizing --> failed

    reserving --> interrupted: startup recovery only
    loading --> interrupted: startup recovery only
    prefill --> interrupted: startup recovery only
    thinking --> interrupted: startup recovery only
    generating --> interrupted: startup recovery only
    waiting_tool --> interrupted: startup recovery only
    waiting_approval --> interrupted: startup recovery only
    finalizing --> interrupted: startup recovery only

    completed --> [*]
    failed --> [*]
    cancelled --> [*]
    interrupted --> [*]
